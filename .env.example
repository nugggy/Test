# Copy this file to .env.local and fill in your own Supabase project values.
# Get these from your Supabase project: Project Settings → API.
# NEVER commit .env.local — it's already covered by .gitignore's `.env*` rule.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key above is safe to expose in the browser — it only grants what
# your Row Level Security policies allow. Do NOT add the Supabase
# service_role key to this app; it bypasses RLS entirely and must never be
# used in client- or server-rendered app code.
